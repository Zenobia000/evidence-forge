  "cards": [
    {
      "dot": "emerald",
      "title": "六條法寶規則",
      "items": [
        "沒有最小規格，不要叫 AI 大量開工",
        "一個切片只做一條可驗收功能",
        "每次提交都附上對應的 AC 與測試",
        "每 2–3 個切片一定做一次收斂檢查",
        "涉及契約、資料模型、安全，一律人審",
        "文件跟 PR 一起更新，不准事後補"
      ]
    },
    {
      "dot": "amber",
      "title": "紅黃綠燈：往下、先補、還是回頭",
      "items": [
        "綠燈：規格清楚、可驗收、證據齊 → 往下一步",
        "黃燈：功能可做，但文件未同步或流程仍不穩 → 可前進，先補文件或補測試",
        "紅燈：規格不明、重做過多、breaking change、測試不可追溯 → 停下來，回上一個節點"
      ]
    },
    {
      "dot": "rose",
      "title": "必停紅燈（沒有例外）",
      "items": [
        "AI 改了資料模型但沒更新規格",
        "AI 改了 API contract",
        "同一個功能第三次重做",
        "PR 大到無法審",
        "測試失敗但追不到是哪條需求",
        "文件描述與畫面／程式行為不同"
      ]
    },
    {
      "dot": "cyan",
      "title": "每一階段測什麼（深度不同，不是只在最後測）",
      "items": [
        "S0：不測 code，確認需求講不講得通",
        "S1：規格審查、AC 可測性",
        "S2：測試案例設計",
        "S3：smoke test、happy path",
        "S4：function、integration、必要時 visual diff",
        "S5：contract／E2E 主路徑",
        "S6：regression、收斂驗證"
      ]
    },
    {
      "dot": "slate",
      "title": "四個回圈：圖上的 A／B／C／D",
      "items": [
        "A｜需求澄清：S2 → S1——AC 寫不出來就回去補規格",
        "B｜切片：S3 ↔ S4——一片做完、測完、修完，再進下一片",
        "C｜收斂：S4 → S5 → S6 → S2——回頭補文件、補契約、補結構",
        "D｜中斷：任何節點 → 停下理解 → 重新插隊 → 回 S2"
      ]
    },
    {
      "dot": "violet",
      "title": "哪些事人不能放手",
      "items": [
        "API breaking change、資料模型改動",
        "權限與安全",
        "跨模組的架構決策",
        "UI／UX 大改",
        "AI 適合的是：scaffold、小範圍實作、補測試、重複性 refactor、變更摘要"
      ]
    }
  ]
