  "cards": [
    {
      "dot": "cyan",
      "title": "三個號碼各是什麼",
      "items": [
        "票號：開票的人給的，分支名 fix/t17 的 t 後面就是它",
        "PR 號：GitHub 配的，與票共用同一個號碼池，所以 #N 看不出型別",
        "標題結尾 (#23) 是 PR 號；內文 Closes #17 是票號"
      ]
    },
    {
      "dot": "emerald",
      "title": "合併方式的差異與代價",
      "items": [
        "squash：main 每顆都是通過檢查的完整狀態，bisect 才可靠",
        "代價：PR 內部的順序沒了，blame 指到 squash 那一顆",
        "rebase merge 保住每顆，但條件是每顆各自通過——閘門驗不了"
      ]
    },
    {
      "dot": "rose",
      "title": "為什麼不用合併鍵",
      "items": [
        "合併鍵會把工作分支上的 merge 原樣帶進 main，長出菱形",
        "菱形讓「這顆 PR 到底改了什麼」變難讀",
        "前一個專案 main 上的兩個菱形就是這樣來的"
      ]
    }
  ]
