#!/usr/bin/env bash
# git 原生 pre-commit：commit 之前掃暫存區有沒有創作者的私人內容（#126）。
#
# 啟用（每個 clone 一次，不會自動做）：  git config core.hooksPath .githooks
# 為什麼要有這個：Claude Code 的守衛（.claude/hooks/guard-git.sh）只管 Claude 下的指令；
# 手動 commit 要靠這個。兩邊呼叫同一支 scripts/brand_guard.py，規則只有一份。
# 命中 exit 1、只印哪個檔哪一行，不印命中的字。掃不了也擋（exit 2）：推出去就收不回來。
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
py=$(command -v python3 || command -v python || true)
if [ -z "$py" ]; then
  echo "pre-commit：私人內容掃描需要 python3，找不到。先擋下；裝好 python3 再 commit。" >&2
  exit 2
fi
exec "$py" "$here/../scripts/brand_guard.py" staged
